{
  "name": "Gestor Finanzas Dev Container",
  "dockerComposeFile": [
    "../docker_local/docker-compose.yml",
    "../docker_local/docker-compose.extend.yml"
  ],
  "service": "backend",
  "workspaceFolder": "/app",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/app/.venv/bin/python",
        "python.analysis.extraPaths": ["/app/src"]
      }
    }
  },
  "forwardPorts": [8000, 8501]
}
