# ==============================================================================
# CONFIGURACIÓN DEL SISTEMA - GESTOR DE FINANZAS PERSONALES Y COMITÉ ASESOR IA
# ==============================================================================
# Copia este archivo a '.env' y completa las variables según tus necesidades:
#   Windows (PowerShell): Copy-Item .env.example .env
#   Linux / macOS:        cp .env.example .env
#
# NOTA ZERO-CONFIG: Si inicias la aplicación sin haber creado '.env', el sistema
# creará automáticamente una copia local a partir de esta plantilla con valores seguros.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. INTELIGENCIA ARTIFICIAL (Google Gemini API)
# ------------------------------------------------------------------------------
# Clave de API de Google AI Studio (https://aistudio.google.com/).
# Opcional: El núcleo contable, pautas y finanzas compartidas funcionan al 100%
# sin clave de API de forma local y determinista.
GEMINI_API_KEY=tu_api_key_aqui

# Modelos recomendados (por defecto: gemini-3.5-flash-lite / gemma-4-31b-it)
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_NEWS_MODEL=gemma-4-31b-it
GEMINI_DEEPDIVE_MODEL=gemini-3.5-flash-lite
GEMINI_COPILOT_MODEL=gemini-3.5-flash-lite
GEMINI_COMMITTEE_MODEL=gemini-3.5-flash-lite

# ------------------------------------------------------------------------------
# 2. CONFIGURACIÓN DE RED Y SERVICIOS
# ------------------------------------------------------------------------------
API_URL=http://127.0.0.1:8000
FRONTEND_PORT=8501
BACKEND_PORT=8000

# ------------------------------------------------------------------------------
# 3. SISTEMA DE LOGS Y OBSERVABILIDAD
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
BACKEND_LOG_FILE=logs/backend.log
FRONTEND_LOG_FILE=logs/frontend.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3

# ------------------------------------------------------------------------------
# 4. POLÍTICAS DE CACHÉ DE MERCADO
# ------------------------------------------------------------------------------
# Tiempo de vida de la caché del análisis fundamental en días (por defecto: 14)
DEEPDIVE_CACHE_TTL_DAYS=14

# ------------------------------------------------------------------------------
# 5. SINCRONIZACIÓN LOCAL-FIRST P2P (Syncthing - Cuenta Conjunta)
# ------------------------------------------------------------------------------
# Identificador de este dispositivo (ej. PC_RAUL, PC_EVITA).
# Opcional: Si se deja vacío, el backend generará automáticamente un ID persistente en src/backend/data/device_id.txt.
DEVICE_ID=

# ------------------------------------------------------------------------------
# 6. GESTIÓN Y COPIAS DE SEGURIDAD (Spec 011)
# ------------------------------------------------------------------------------
# Directorio donde se almacenan los respaldos atómicos (.db) de seguridad.
# Opcional (por defecto: backups)
BACKUP_DIR=backups

# ------------------------------------------------------------------------------
# 7. ACTUALIZACIONES OVER-THE-AIR (Spec 012 - In-App OTA Updater)
# ------------------------------------------------------------------------------
# Repositorio oficial o fork desde donde se descargan las actualizaciones de código.
# Opcional (por defecto: Raul515 / GestorFinanzas / rama main)
GITHUB_REPO_OWNER=Raul515
GITHUB_REPO_NAME=GestorFinanzas
UPDATE_BRANCH=main

# Token personal de GitHub (Classic Token con permiso 'public_repo' o sin scopes).
# Opcional: Solo necesario si deseas superar el límite de 60 peticiones/hora de GitHub API pública.
GITHUB_TOKEN=
